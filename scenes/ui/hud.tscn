[node name="HelpLabel" type="Label" parent="."]
layout_mode = 1
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -1000.0
offset_top = -84.0
offset_right = -16.0
offset_bottom = -16.0
grow_horizontal = 0
grow_vertical = 0
theme_override_colors/font_color = Color(0.56, 0.63, 0.7, 1)
theme_override_font_sizes/font_size = 15
text = "좌클릭 = 보기·고르기 (대원은 움직이지 않음) · 우클릭 = 지시
· 임무: 분대 클릭 → 층 우클릭 (외벽 층·내부 화면·왼쪽 층 막대) → 지시 창 — Q 인명검색 · W 화재진압 · E 직하층 확인 · D 분대별 기본(여러 분대) · 1~9 진입구 · Enter 지시
· 우클릭 대상: 노란 진입구 = 그 문 앞으로 · 바깥 땅 = 분대 이동 · 펌프차 = 수관 연장 · 창 = 깨기 · 요구조자 = 구조 · 창가 구조대상자 아래 땅 = 매트 · 승강기 앞에서 다른 층 = 승강기
· 분대 명령 칸: Q 경계 · W 배연 · A 대기(보고 요청·여기로·지원 투입·구조자 관찰·방수 중지) · S 철수 · 고른 분대의 팀장을 한 번 더 클릭 = 나누기·합치기·한 명 보내기·복귀
· 지휘관 클릭 → 땅 우클릭 = 지휘관 이동 · 관계인 클릭 = 질문 · 숫자 1~9 = 분대 고르기 (카드가 떠 있으면 1~4는 카드 답)
· 보기: 외벽 층 클릭 = 그 층 내부 · 바깥 땅 클릭 = 외부 · PgUp/PgDn 층 · 휠 줌 · 화면 가장자리·방향키 카메라 · Tab·M 전술상황판 · T 열화상 · Space 일시정지 · Esc 메뉴
· 대원이 판단을 물으면(진입 허가·문·계단·주수 방법) 카드에서 고른다 · 지휘관 명령(선언·보고·지원·안전·구역)은 화면 아래 묶음"
horizontal_alignment = 2
autowrap_mode = 3
vertical_alignment = 2
