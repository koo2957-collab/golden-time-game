offset_bottom = -16.0
grow_horizontal = 0
grow_vertical = 0
theme_override_colors/font_color = Color(0.56, 0.63, 0.7, 1)
theme_override_font_sizes/font_size = 15
text = "명령 카드 Q W E R / A S (원형 메뉴와 같음) · 팀: Q 인명검색 · W 화점진압 · E 경계 · R 배연 · A 대기 · S 철수 · 지휘관 명령(선언·보고·지원·안전·구역)은 화면 아래 지휘관 명령 묶음을 눌러 펼친 뒤 · 지도에서 조 클릭: 원형 메뉴 · 우클릭(상황 행동): 이동 · 펌프차 수관 · 닫힌 문 개방 · 창 깨기 · 요구조자 구조 · 창가 구조대상자 아래 땅에 매트 · 승강기 앞에서 다른 층 = 승강기 · 주수 방법은 화점실 앞 카드 · 관계인 클릭: 질문 · 건물 안 임무를 받은 조는 입구에서 진입 허가 요청 (카드 1~3)
화면 가장자리·방향키·휠 버튼 끌기 카메라 · 휠 줌 · PgUp/PgDn 층 · Tab·M 전술상황판(보고된 것만) · 1~9 팀 선택(아래 팀 초상 줄 순서, 카드가 떠 있으면 1~4는 카드 답) · 무전 기록 항목 클릭 = 그 대원으로 · Esc 마우스 풀기·메뉴 · T 열화상 · Space 일시정지"
horizontal_alignment = 2
autowrap_mode = 3
vertical_alignment = 2
