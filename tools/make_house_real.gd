		"legend": {" ": "빈 공간", ",": "마당", "=": "차도", "-": "보도", ".": "실내 바닥", "#": "벽", "D": "문", "W": "창", "S": "계단"},
		"floors": [
			{"level": 1, "name": "1층", "grid": _site(F1, true), "rooms": _rooms(ROOMS1, HOUSE) + _rooms(NB_ROOMS, NEIGHBOR),
				"furniture": _furniture(FURN1, HOUSE) + _furniture(NB_FURN, NEIGHBOR)},
			{"level": 2, "name": "2층", "grid": _site(F2, false), "rooms": _rooms(ROOMS2, HOUSE), "furniture": _furniture(FURN2, HOUSE)},
		],
	}
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	f.store_string(JSON.stringify(data, "  ", false) + "\n")
	f.close()
	print("wrote ", OUT)
	quit()


## 대지 격자 (72줄): ground = 1층(마당·보도·차도·옆집을 깐다), 아니면 빈 공간 위에 화재 건물만
func _site(house: Array, ground: bool) -> Array:
	var rows: Array = []
	for y in H:
		var line := ""
		for x in W:
			var ch := " "
			if ground:
				ch = ","
				if x >= ROAD_FROM or y >= ROAD_FROM:
					ch = "="
				elif x >= WALK_FROM or y >= WALK_FROM:
					ch = "-"
				var n := Vector2i(x, y) - NEIGHBOR
				if n.x >= 0 and n.y >= 0 and n.y < NB.size() and n.x < 14:
					ch = (NB[n.y] as String)[n.x]
			var h := Vector2i(x, y) - HOUSE
			if h.x >= 0 and h.y >= 0 and h.y < house.size() and h.x < 19:
				var c := (house[h.y] as String)[h.x]
				# 건물 밖(',' 또는 ' ')은 대지 그대로 둔다
				if c != "," and c != " ":
					ch = c
			line += ch
		rows.append(line)
	return rows


func _rooms(list: Array, at: Vector2i) -> Array:
	var out: Array = []
	for r: Array in list:
		var room := {"id": r[0], "name": r[1], "rect": [at.x + int(r[2]), at.y + int(r[3]), int(r[4]), int(r[5])]}
		if str(r[6]) != "":
			room["lining"] = r[6]
		out.append(room)
	return out


func _furniture(list: Array, at: Vector2i) -> Array:
	var out: Array = []
	for f: Array in list:
		out.append({"name": f[0], "material": f[1], "rect": [at.x + int(f[2]), at.y + int(f[3]), int(f[4]), int(f[5])]})
	return out
